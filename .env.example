# Credentials used by the jobup.ch/jobs.ch login automation (routes/api.js -> scripts/jobup-login.js
# -> scripts/jobup-search.js). Copy this file to .env and fill in real values. .env is gitignored -
# never commit real credentials. Which pair is used is picked at runtime by the "Use www.jobs.ch"
# checkbox next to the Login button (and, separately, the CV Analysis job filters' own copy of that
# checkbox) - see the root CLAUDE.md's "jobup.ch login automation" section.
JOBUP_EMAIL=
JOBUP_PASSWORD=
JOBSCH_EMAIL=
JOBSCH_PASSWORD=
